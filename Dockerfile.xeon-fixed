# Layered on top of the upstream SGLang CPU image.
#
# Upstream `sglang-cpu:xeon` (built from sglang/docker/xeon.Dockerfile)
# ships the AMX-aware kernels and the binary sgl_kernel built for CPU,
# but does NOT ship sentencepiece / tiktoken / protobuf which most
# modern HF tokenizers (Qwen3, GLM, Mistral, Llama 3) need to load.
#
# It also installs Python via `uv`, so the resulting venv has neither
# `pip` nor `uv` on PATH inside the container — only `/opt/.venv/bin/python`.
# We bootstrap pip via `python -m ensurepip` (CPython stdlib), then
# install the missing tokenizer deps.
#
# Build with one of:
#
#   # Build the upstream base from source (~15-20 minutes first run):
#   git clone --depth 1 https://github.com/sgl-project/sglang.git /tmp/sglang
#   docker build -f /tmp/sglang/docker/xeon.Dockerfile -t sglang-cpu:xeon /tmp/sglang
#
#   # Then layer this fix on top (~1-2 minutes):
#   docker build -f Dockerfile.xeon-fixed -t sglang-cpu:xeon-fixed .
#
# Verify the fix works:
#
#   docker run --rm sglang-cpu:xeon-fixed /opt/.venv/bin/python -c \
#     "import sentencepiece, tiktoken; from google import protobuf; \
#      print('OK', sentencepiece.__version__, tiktoken.__version__, protobuf.__version__)"
#
# Note on protobuf: the package is installed via the name `protobuf` but
# imports as `google.protobuf` — `import protobuf` will fail even though
# the install succeeded.

FROM sglang-cpu:xeon

RUN /opt/.venv/bin/python -m ensurepip --upgrade && \
    /opt/.venv/bin/python -m pip install --no-cache-dir \
        sentencepiece \
        tiktoken \
        protobuf
